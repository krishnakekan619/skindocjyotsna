# Tool version POLICY for the offline setup bundles (Windows and macOS).
# Format: KEY=VALUE, no spaces, no quotes. Read by PowerShell and bash.
#
# The exact pinned versions live in the lock files (setup/windows/tools.lock,
# setup/macos/tools.lock). This file only says which releases to pick when a lock is
# created or updated (Prepare ... -UpdateLock / --update-lock), and the minimum versions
# a developer PC may keep.

# Which release to pin when updating the lock: a major (newest stable 24.x) or "stable".
NODE_VERSION=24
RUST_VERSION=stable

# Role "Dev": an already-installed tool at or above this version is reused, not reinstalled.
# (Role "Build" ignores these: Node and Rust must match the lock exactly.)
NODE_MIN_VERSION=24.0.0
RUST_MIN_VERSION=1.95.0
GIT_MIN_VERSION=2.40.0

# Windows only
VS_BUILDTOOLS_CHANNEL=17
# Only what Rust/Tauri need: the MSVC x64 compiler + linker, and the Windows 11 SDK.
VS_COMPONENTS=Microsoft.VisualStudio.Component.VC.Tools.x86.x64,Microsoft.VisualStudio.Component.Windows11SDK.26100
WEBVIEW2_URL=https://go.microsoft.com/fwlink/?linkid=2124701
